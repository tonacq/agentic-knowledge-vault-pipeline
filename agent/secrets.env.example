# Copy this file to secrets.env (same folder) and fill in real values.
# This is the SHARED/agent-level version - use this if you want one Telegram
# bot/chat for every vault, rather than a separate one per vault (see
# vaults/_template/config/secrets.env.example for the per-vault version).
# secrets.env is intentionally not committed to source control - keep it out.
#
# Vault-level secrets.env (if present) is checked first and takes precedence
# over this shared file - see send-notification.ps1's credential resolution
# order for the exact logic.
#
# Leave blank / omit this file entirely to disable Telegram notifications.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
