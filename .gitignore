# Vault runtime content - never committed, contains real channel/creator details
vaults/*
!vaults/_template

# Local-only scheduling config - contains real vault names, see schedule.csv.example
agent/scheduling/schedule.csv

# Session-local operational artifacts
agent/scheduling/dispatch-logs/
**/working/temp/ingest-errors.log
conformance-report*.json
agent/secrets/*
!agent/secrets/*.example
agent/secrets.env

# Local-only report output from token-usage-report.sh - real per-vault token history,
# same treatment as schedule.csv/manifest.csv (the script itself is tracked)
token-usage.csv
